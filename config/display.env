# NeoDSE display settings shared by Weston and the UI.
# See docs/CONFIGURATION.md for accepted values and applying changes.
# Omitted settings use the compositor helper and renderer defaults.

# Weston output: restart neodse-weston.service after editing these settings.
NEODSE_WESTON_SCALE=1
NEODSE_WESTON_TRANSFORM=normal

# UI appearance: restart neodse-ui.service after editing these settings.
NEODSE_WAITING_LOGO_SCALE=1.0
NEODSE_STATUS_LOGO_SCALE=1.0
NEODSE_FRIENDLY_NAME_SCALE=1.0
NEODSE_CLOCK_SCALE=1.0
NEODSE_BANNER_SCALE=1.0
NEODSE_UI_ZOOM=1.0
NEODSE_UI_LOGO_ANIMATION=show
NEODSE_UI_STATUS_LOGO=show
NEODSE_UI_FRIENDLY_NAME=show
NEODSE_UI_CLOCK=show
NEODSE_UI_DEVICE_INFO=hide
NEODSE_UI_STATUS_MESSAGE=hide
NEODSE_UI_WAITING_OVERLAYS=hide
